# Secret key for hashing sender IDs (HMAC-SHA256). At least 32 characters.
# Generate one with: openssl rand -hex 32
SENDER_HASH_SECRET=

# Where the local PGlite database lives (development only).
PGLITE_DATA_DIR=.data/pglite

# Postgres on Neon. Locally, the dev branch (pnpm db:migrate, pnpm test:neon).
DATABASE_URL=
NEON_TEST_URL=

# Telegram: the bot token from BotFather, your own numeric user ID (the admin),
# and a random secret Telegram sends back on every webhook call
# (openssl rand -hex 32).
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
TELEGRAM_WEBHOOK_SECRET=

# Claude, for the agent loop and the eval.
ANTHROPIC_API_KEY=

# Google Safe Browsing v4 (optional: without it, URL reputation lookups
# return "unavailable").
SAFE_BROWSING_API_KEY=

# Vercel sends this as a bearer token to the retention cron; without it the
# cron refuses to run (openssl rand -hex 32).
CRON_SECRET=
